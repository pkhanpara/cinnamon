FINNHUB_API_KEY=

# Optional: SEC EDGAR fundamentals (ADR 0017). SEC requires a name and contact email; off when unset.
# SEC_USER_AGENT=Cinnamon you@example.com

# Optional: "Ask AI" panel on the ticker page. Any OpenAI-compatible server (llama-swap, Ollama, OpenAI).
# Both URL and model must be set for the feature to appear. See ADR 0008.
# LLM_BASE_URL=http://<host>:<port>/v1
# LLM_MODEL=
# LLM_API_KEY=
# LLM_DISABLE_THINKING=true   # default; set false for OpenAI, which rejects the extra field
# LLM_MAX_TOKENS=96000        # default; ceiling on answer length, lower it for hosted models
